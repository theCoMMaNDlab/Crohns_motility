# DOE driver working tree: reference runs and per-case run directories.
doe_work/

# generate_doe.py's optional standalone output -- run_doe.py no longer
# reads from disk, it renders each case's *PARAMETER block in memory.
doe_params/

# Abaqus job output. The decks (*.inp) and user subroutines (*.f) are
# tracked; everything Abaqus writes alongside them is not.
*.odb
*.sta
*.msg
*.dat
*.log
*.com
*.lck
*.mdl
*.prt
*.res
*.stt
*.sim
*.abq
*.pac
*.sel
*.ipm
*.SMABulk
*.023

# Final DOE table written by run_doe.py.
DOE_MM_results.txt

# Post-processing output written into whichever directory the scripts run in.
triad_fields.inp
motility_volume_cross_sections.csv
cycle_volume.txt

# Python
__pycache__/
*.pyc

# Editor and OS files
.DS_Store
.claude/
